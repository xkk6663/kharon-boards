/*
 * kharon-boards/boards/espressif/korvo1/korvo1_hpcore.dts
 *
 * 一块物理 PCB = 一个 board：Korvo-1 是 ESP32-S31 高性能核板。
 * 所有 Korvo-1 实验台都成立的接线都收在这里，APP 的 overlay 只留
 * 本 APP 额外要的外设。
 */

/dts-v1/;

#include <espressif/esp32s31/esp32s31.dtsi>
#include "korvo1-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/led/led.h>
#include <espressif/partitions_0x2000_default_16M.dtsi>

/ {
	compatible = "espressif,esp32s31";
	model = "ESP32-S31-Korvo-1 HP Core";

	chosen {
		zephyr,sram = &sramhp;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,canbus = &twai0;
	};

	aliases {
		sw0 = &boot_button;
		led-strip = &led_strip;
		watchdog0 = &wdt0;
		pa-ctrl = &pa_ctrl;
	};

	led_strip: ws2812 {
		compatible = "worldsemi,ws2812-pulse-io";
		pulse-ios = <&rmt 0>;
		chain-length = <1>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
		reset-delay = <300>;
	};

	gpio_keys {
		compatible = "gpio-keys";

		boot_button: button {
			label = "Boot Button";
			gpios = <&gpio1 29 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	leds {
		compatible = "gpio-leds";

		pa_ctrl: pa_ctrl_0 {
			gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
			label = "PA_CTRL";
		};
	};

	/*
	 * 板级电气事实出口：APP 只认能力，不认 IO42 / 四键 mV。
	 * io-channels 同时给出 ADC 单元与通道，key-thresholds-mv 是四键的
	 * 实测电压梯；没有这块板的设备不会拥有这个节点，APP 用
	 * DT_NODE_EXISTS(DT_PATH(zephyr_user)) 自动裁掉 ADC 键功能。
	 */
	zephyr,user {
		io-channels = <&adc0 0>;
		key-pad-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
		key-thresholds-mv = <260 759 1237 1647>;
		key-adc-vref-mv = <3300>;
	};
};

&flash0 {
	reg = <0x0 DT_SIZE_M(16)>;
	ranges = <0x0 0x0 DT_SIZE_M(16)>;
};

&psram0 {
	size = <DT_SIZE_M(16)>;
};

&uart0 {
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c0 {
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&rmt {
	pinctrl-0 = <&rmt_default>;
	pinctrl-names = "default";
	status = "okay";
};

&twai0 {
	pinctrl-0 = <&twai0_default>;
	pinctrl-names = "default";
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&trng0 {
	status = "okay";
};

/* IO42 上的四键是一路 ADC 读四种电压；S31 的 unit 号在 SoC dtsi 里错位，
 * 板级层改回 0 基：ADC1=0、ADC2=1。
 */
&adc0 {
	unit = <0>;
	status = "okay";
};

&adc1 {
	unit = <1>;
	status = "okay";
};

/* Internal LDO channel 1 powers the on-board PSRAM at 1.8 V. */
&ldo {
	status = "okay";

	ldo1@1 {
		regulator-init-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};
};
